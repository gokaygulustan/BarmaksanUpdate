# Kopyalayın: apps/api/.env  (gerçek değerler asla depoya girmez)

# Veritabanı (PostgreSQL)
DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST:5432/VERITABANI"

# Kimlik doğrulama: uzun, rastgele bir dize
JWT_SECRET="degistirin-uzun-rastgele-bir-dize"

# Sunucu
PORT=4000
NODE_ENV=development

# Ön yüz adresi (e-posta linkleri ve CORS)
FRONTEND_URL="http://localhost:3000"

# E-posta (Nodemailer)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="kullanici@example.com"
SMTP_PASS="sifre"
SMTP_FROM="Tedarik Portalı <noreply@example.com>"

# Yalnızca yerel geliştirme: true ise /login şifre kontrolünü atlar. Sunucuda ASLA true yapmayın.
# DEV_LOGIN_BYPASS=false
